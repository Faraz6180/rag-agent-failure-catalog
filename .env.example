# Only needed for --live runs. Offline mode (the default) needs no keys.
# Copy this file to .env and fill in what you use. Never commit .env.

# openai | anthropic. If unset, the first key found below is used (Anthropic first).
RAG_CATALOG_PROVIDER=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
